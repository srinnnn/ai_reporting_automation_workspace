# AI Reporting Automation Workspace environment template
# Copy this file to .env for local Docker or local development.
# Do not commit .env or any real secrets.

# Application runtime
APP_ENV=development
APP_DEBUG=false
INTRANET_HOST=0.0.0.0
INTRANET_PORT=8785
INTRANET_ADMIN_PASSWORD=
INTRANET_SECRET_KEY=

# Database
DATABASE_BACKEND=sqlite
DATABASE_URL=
SQLITE_PATH=/app/intranet_app/runtime/intranet.sqlite3

# File storage
RUNTIME_DIR=/app/intranet_app/runtime
UPLOAD_DIR=/app/intranet_app/runtime/uploads
RESULT_DIR=/app/intranet_app/runtime/results
LOG_DIR=/app/intranet_app/runtime/logs
TEMPLATE_ROOT=/app/ai_report_config_materials

# Task mode
REPORT_TASK_MODE=legacy

# AI provider configuration
AI_PROVIDER=bailian
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
DASHSCOPE_API_KEY=

# Anta retail local launcher, optional
ANTA_RETAIL_HOST=127.0.0.1
ANTA_RETAIL_PORT=8766
ANTA_RETAIL_PROJECT_ROOT=